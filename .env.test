# ==============================================================================
# Isolated Test Environment Configuration
# ==============================================================================
NODE_ENV=test
PORT=3001
API_PREFIX=/api/v1

# Dedicated PostgreSQL Test Database (fails fast if pointing to prod or dev default)
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=chat_backend_test
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
DATABASE_URL="postgresql://${POSTGRES_USER}:${POSTGRES_PASSWORD}@${POSTGRES_HOST}:${POSTGRES_PORT}/${POSTGRES_DB}?schema=public"

# Firebase / Firestore Emulator Configuration
FIRESTORE_EMULATOR_HOST="127.0.0.1:8080"
FIREBASE_PROJECT_ID="chat-backend-test"

# Security Configuration
JWT_SECRET="test-only-super-secret-jwt-key-minimum-32-chars-long!"
JWT_EXPIRES_IN="1h"
ALLOW_DEV_IMPERSONATION=false

# Rate Limiting in Tests (relaxed for fast test execution)
RATE_LIMIT_WINDOW_MS=60000
RATE_LIMIT_MAX=10000
AUTH_RATE_LIMIT_MAX=10000
CORS_ORIGIN="*"
