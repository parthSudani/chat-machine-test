# ==============================================================================
# Server Configuration
# ==============================================================================
PORT=3000
NODE_ENV=development
API_PREFIX=/api/v1

# ==============================================================================
# Database Configuration (PostgreSQL / Prisma)
# ==============================================================================
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=chat_backend
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
DATABASE_URL="postgresql://${POSTGRES_USER}:${POSTGRES_PASSWORD}@${POSTGRES_HOST}:${POSTGRES_PORT}/${POSTGRES_DB}?schema=public"

# ==============================================================================
# Firebase / Firestore Configuration
# ==============================================================================
# In local development & testing, setting FIRESTORE_EMULATOR_HOST uses the local emulator:
FIRESTORE_EMULATOR_HOST="localhost:8080"
FIREBASE_PROJECT_ID="chat-backend-dev"

# In production (when not using emulator), provide the path to your service account key or ADC:
# GOOGLE_APPLICATION_CREDENTIALS="/path/to/service-account.json"

# ==============================================================================
# Security & Authentication
# ==============================================================================
JWT_SECRET="replace-with-a-very-secure-random-secret-key-at-least-32-chars"
JWT_EXPIRES_IN="7d"

# Assessment Mode: When true, allows testing body-provided user IDs if JWT is omitted in non-production
ALLOW_DEV_IMPERSONATION=false

# Rate Limiting
RATE_LIMIT_WINDOW_MS=60000
RATE_LIMIT_MAX=100
